#!/usr/bin/env bash
# kcx - one kubeconfig file per cluster, a context picker, temp kind clusters on any
# Docker engine, and a read-only shell for AI tools. `kcx -h` lists the commands.
#
# Layout, under ~/.kube (directories 0700, files 0600):
#   config                 the state file: the current context, and nothing of kcx's
#                          besides. kubectl writes current-context into the FIRST
#                          existing file in KUBECONFIG, so this one comes first and a
#                          switch never rewrites a file that holds credentials. A tool
#                          that writes "the default kubeconfig" (a cloud CLI run
#                          without a file option, minikube) lands here too: `kcx ls`
#                          points such entries out and `kcx adopt` moves one into a
#                          file of its own.
#   configs/NAME.yaml      one permanent cluster. Import renames its cluster, user and
#                          context to NAME, so no two files share an entry: adding a
#                          cluster never overwrites another one's credentials, which is
#                          what happens when every tool merges into one file.
#   temp/NAME@ENGINE.yaml  one temp kind cluster; ENGINE is the docker context it runs
#                          on. Deleted with the cluster, whose credentials die with it.
# KUBECONFIG = config:configs/*.yaml:temp/*.yaml, each directory sorted. ~/.zshenv
# sets it for every zsh with the same rule as _kcx_files below (keep the two in
# step); `kcx env` prints it for any other shell.
#
# Managed files carry no current-context of their own: with none in the state file,
# kubectl falls back to the first file that sets one, which would make some cluster
# current without anyone choosing it.
#
# Agents: every shell shares one current context, so a switch in one session points
# kubectl in all the others at another cluster. Name the cluster per command:
#   kubectl --context NAME ...      or      kcx run NAME -- COMMAND...
# and use `kcx -r NAME -- COMMAND...` for anything that should only read.
#
# Needs bash 3.2 or later (macOS's own /bin/bash), kubectl and jq; fzf for the
# pickers; docker and kind for temp clusters; yq to aim a kind preset at a remote
# engine.

_KCX_VERSION="1.0.0"
# 1 on a lab node (role docker-engine), rendered by chezmoi: a permanent cluster's
# credentials do not belong on one, so `kcx add` and `kcx adopt` refuse there.
_kcx_lab_node={{ $roles := list }}{{ if hasKey . "roles" }}{{ $roles = .roles }}{{ end }}{{ if has "docker-engine" $roles }}1{{ else }}0{{ end }}

_kcx_dir="$HOME/.kube"
_kcx_state="$_kcx_dir/config"
_kcx_perm="$_kcx_dir/configs"
_kcx_tmpd="$_kcx_dir/temp"
_kcx_prev="$_kcx_dir/kubectx"    # kubectx keeps "previous" in the same file, so both agree
_kcx_presets="$HOME/.config/kind"
# The read-only proxy rejects writes by method, and exec, attach and port-forward by
# path whatever the method: kubectl 1.30 and later send those as a GET that upgrades
# to a WebSocket, and port-forward went through kubectl proxy's default paths when
# tested (kubectl 1.37). --reject-paths replaces the defaults, hence all three.
_kcx_ro_methods='POST,PUT,PATCH,DELETE'
_kcx_ro_paths='^/api/.*/pods/.*/exec,^/api/.*/pods/.*/attach,^/api/.*/pods/.*/portforward'
_kcx_tab="$(printf '\t')"
_kcx_inherited=""    # the KUBECONFIG of the shell that ran kcx, before kcx sets its own

_kcx_err() { printf 'kcx: %s\n' "$*" >&2; }
_kcx_die() { _kcx_err "$@"; exit 1; }
_kcx_usage_die() { _kcx_err "$@"; printf 'Run kcx -h for the commands.\n' >&2; exit 2; }

# Temp files and the read-only proxy go when kcx exits, however it exits.
_kcx_cleanup=()
_kcx_proxy_pid=""
_kcx_on_exit() {
  local p
  [ -n "$_kcx_proxy_pid" ] && kill "$_kcx_proxy_pid" 2>/dev/null
  for p in ${_kcx_cleanup[@]+"${_kcx_cleanup[@]}"}; do rm -rf -- "$p"; done
}
trap _kcx_on_exit EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

_kcx_workdir() {   # sets _kcx_wd to a private temp directory, removed on exit. Not
  # called as $(...): a subshell's addition to the cleanup list would be lost.
  _kcx_wd="$(mktemp -d "${TMPDIR:-/tmp}/kcx.XXXXXX")" || _kcx_die "mktemp failed"
  _kcx_cleanup[${#_kcx_cleanup[@]}]="$_kcx_wd"
}

_kcx_usage() {
  cat <<'EOF'
kcx - one kubeconfig file per cluster under ~/.kube, and the tools to use them.

  kcx                         pick a context (fzf); the top line makes a temp cluster
  kcx NAME                    switch to context NAME
  kcx -                       switch to the previous context
  kcx -c                      print the current context
  kcx ls [-q]                 every context: where its file lives and its server
                              (-q: names only)
  kcx env                     print the KUBECONFIG export line, for shells other than zsh
  kcx run NAME -- CMD...      run one command against NAME, leaving the current
                              context alone: what agents should use
  kcx -r [NAME] [-- CMD...]   a read-only shell for NAME, or one read-only command:
                              writes, exec, attach and port-forward are refused

Permanent clusters, one file each in ~/.kube/configs:
  kcx add NAME FILE           import the kubeconfig in FILE as NAME
  kcx add NAME -              ... read from standard input
  kcx add NAME -- CMD...      run CMD with KUBECONFIG set to a new, empty file and
                              import what it writes there; an argument {} is replaced
                              by that file's path, for tools with a file option
      -f                      replace an existing NAME (the old file goes to the Trash)
      --context CTX           the context to take, when the source holds several
      --server URL            rewrite the cluster's server address
      --use                   switch to NAME afterwards
  kcx rm NAME                 move NAME's file to the Trash
  kcx mv OLD NEW              rename a permanent cluster
  kcx adopt CTX [NAME]        move a context another tool wrote into ~/.kube/config
                              into a file of its own

Temp clusters, kind, one file each in ~/.kube/temp:
  kcx temp create NAME [--engine DOCKER_CONTEXT] [--config PRESET|FILE] [--use] [-- KIND_ARGS...]
                              DOCKER_CONTEXT: the engine to run on (default: docker's
                              current one); on a remote engine the API server listens
                              on the engine's network address. PRESET: a file in
                              ~/.config/kind; without --config, kind's own one-node
                              cluster. The context is kind-NAME.
  kcx temp ls                 temp clusters, and whether each still exists
  kcx temp rm NAME            delete the cluster and its kubeconfig
  kcx temp prune              delete the kubeconfigs of clusters that are gone
  kcx temp add NAME FILE|-|-- CMD...
                              keep another tool's temp cluster (k3d, minikube) here

  kcx -v                      version          kcx -h    this help

Examples:
  kcx add eks-lab -- aws eks update-kubeconfig --name lab --region us-west-2
  kcx add oke-lab -- oci ce cluster create-kubeconfig --cluster-id ID --file {}
  ssh pi sudo cat /etc/rancher/k3s/k3s.yaml | kcx add pi - --server https://pi.lan:6443
  kcx temp create t1 --engine lab --config calico-iptables
  kcx run kind-t1 -- kubectl get nodes
EOF
}

# ---- the layout ---------------------------------------------------------------

# The files KUBECONFIG lists, in order: the state file first (even before it exists),
# then the permanent and the temp clusters, each directory sorted. ~/.zshenv carries
# the same rule in zsh.
_kcx_files() {
  printf '%s\n' "$_kcx_state"
  _kcx_dir_files "$_kcx_perm"
  _kcx_dir_files "$_kcx_tmpd"
}
_kcx_dir_files() {   # *.yaml regular files, no dotfiles (kcx writes through .kcx.*)
  [ -d "$1" ] || return 0
  find -H "$1" -mindepth 1 -maxdepth 1 -type f -name '*.yaml' ! -name '.*' 2>/dev/null | LC_ALL=C sort
}
_kcx_kubeconfig() {
  local f out=""
  while IFS= read -r f; do out="${out:+$out:}$f"; done < <(_kcx_files)
  printf '%s\n' "$out"
}

_kcx_ensure_layout() {   # the directories, private, and the state file
  local d
  for d in "$_kcx_dir" "$_kcx_perm" "$_kcx_tmpd"; do
    [ -d "$d" ] || mkdir -m 700 "$d" || _kcx_die "cannot create $d"
    chmod go-rwx "$d" 2>/dev/null
  done
  if [ ! -e "$_kcx_state" ]; then
    ( umask 077; printf 'apiVersion: v1\nkind: Config\npreferences: {}\n' > "$_kcx_state" ) \
      || _kcx_die "cannot create $_kcx_state"
  fi
}

# shellcheck disable=SC2088  # "~/.kube/config" is text for the reader, not a path
_kcx_where() {   # how `ls` names the place a file lives
  case "$1" in
    "$_kcx_state") printf '%s\n' "~/.kube/config (written by another tool)" ;;
    "$_kcx_perm"/*) printf '%s\n' "configs" ;;
    "$_kcx_tmpd"/*@*) local b="${1##*/}"; b="${b%.yaml}"; printf 'temp, on %s\n' "${b#*@}" ;;
    "$_kcx_tmpd"/*) printf '%s\n' "temp" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

# One pass over one file: "ctx<TAB>name<TAB>server" per context, "ent<TAB>map<TAB>name"
# per cluster, user and context, and "cur<TAB>name" when the file sets a current context.
_kcx_scan() {
  kubectl --kubeconfig "$1" config view -o json 2>/dev/null | jq -r '
    (.clusters // []) as $cl
    | ((.contexts // [])[] | . as $c
        | "ctx\t\($c.name)\t\(([$cl[] | select(.name == $c.context.cluster) | .cluster.server][0]) // "-")"),
      ((.clusters // [])[] | "ent\tcluster\t\(.name)"),
      ((.users // [])[] | "ent\tuser\t\(.name)"),
      ((.contexts // [])[] | "ent\tcontext\t\(.name)"),
      (if (.["current-context"] // "") != "" then "cur\t\(.["current-context"])" else empty end)
  ' 2>/dev/null
}
_kcx_entries() {   # map<TAB>name for every cluster, user and context in one file
  _kcx_scan "$1" | sed -n "s/^ent${_kcx_tab}//p"
}
_kcx_contexts_in() {
  kubectl --kubeconfig "$1" config get-contexts -o name 2>/dev/null
}

_kcx_all_contexts() { kubectl config get-contexts -o name 2>/dev/null; }
_kcx_has_context() { _kcx_all_contexts | grep -Fxq -- "$1"; }
_kcx_current() { kubectl config current-context 2>/dev/null; }

# A name that is safe as a file name and in KUBECONFIG: letters, digits, . _ and -,
# starting with a letter or a digit. No @, which separates a temp file's engine.
_kcx_valid_name() {
  case "$1" in ''|*[!A-Za-z0-9._-]*|[._-]*) return 1 ;; esac
  [ "${#1}" -le 63 ]
}
_kcx_valid_kind_name() {   # what kind accepts as a cluster name
  case "$1" in ''|*[!a-z0-9.-]*|[.-]*) return 1 ;; esac
  [ "${#1}" -le 40 ]
}

_kcx_trash() {   # move files to the Trash; kcx never deletes a permanent cluster's file
  local f
  if [ -n "${KCX_TRASH_DIR:-}" ]; then   # tests: a stand-in Trash
    mkdir -p "$KCX_TRASH_DIR" || return 1
    for f in "$@"; do mv -- "$f" "$KCX_TRASH_DIR/${f##*/}.$(date +%Y%m%d%H%M%S).$$" || return 1; done
    return 0
  fi
  if [ -x /usr/bin/trash ]; then
    /usr/bin/trash "$@" || return 1
  elif command -v gio >/dev/null 2>&1; then
    gio trash -- "$@" || return 1
  else
    _kcx_err "no Trash on this machine; move it yourself: $*"; return 1
  fi
  for f in "$@"; do [ ! -e "$f" ] || return 1; done
}

# ---- the current context ------------------------------------------------------

_kcx_set_current() {   # into the state file, explicitly: never into a credential file
  _kcx_ensure_layout
  kubectl --kubeconfig "$_kcx_state" config set current-context "$1" >/dev/null 2>&1 \
    || _kcx_die "could not write the current context into $_kcx_state"
}
_kcx_clear_current() {
  [ -f "$_kcx_state" ] || return 0
  kubectl --kubeconfig "$_kcx_state" config unset current-context >/dev/null 2>&1
}
_kcx_use() {   # switch, remembering the context we came from (for kcx -)
  local ctx="$1" cur
  cur="$(_kcx_current)"
  _kcx_set_current "$ctx"
  if [ -n "$cur" ] && [ "$cur" != "$ctx" ]; then
    ( umask 077; printf '%s' "$cur" > "$_kcx_prev" )
  fi
}
_kcx_resolve_context() {   # NAME, or kind-NAME for a temp cluster called by its own name
  if _kcx_has_context "$1"; then printf '%s\n' "$1"
  elif _kcx_has_context "kind-$1"; then printf '%s\n' "kind-$1"
  else return 1
  fi
}

_kcx_cmd_switch() {
  local ctx
  ctx="$(_kcx_resolve_context "$1")" || _kcx_die "no context named $1 (kcx ls lists them)"
  _kcx_use "$ctx"
  printf 'kcx: switched to %s\n' "$ctx"
}
_kcx_cmd_previous() {
  local prev
  [ -s "$_kcx_prev" ] || _kcx_die "no previous context recorded yet"
  prev="$(cat -- "$_kcx_prev")"
  _kcx_has_context "$prev" || _kcx_die "the previous context, $prev, no longer exists"
  _kcx_use "$prev"
  printf 'kcx: switched to %s\n' "$prev"
}
_kcx_cmd_current() {
  local cur
  cur="$(_kcx_current)"
  [ -n "$cur" ] || _kcx_die "no current context (kcx NAME picks one)"
  printf '%s\n' "$cur"
}

_kcx_q() {   # single-quote a value for eval
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}
_kcx_cmd_env() {
  # A read-only shell's (or a run's) KUBECONFIG is the point of it: a startup file
  # that evals this must get that one back, never the real credentials.
  if [ -n "${KCX_RO:-}" ]; then
    printf 'export KUBECONFIG=%s\n' "$(_kcx_q "${KCX_RO_CONFIG:-$KUBECONFIG}")"
    return 0
  fi
  if [ -n "${KCX_RUN:-}" ]; then
    printf 'export KUBECONFIG=%s\n' "$(_kcx_q "$KUBECONFIG")"
    return 0
  fi
  printf 'export KUBECONFIG=%s KCX_AUTO=%s\n' "$(_kcx_q "$KUBECONFIG")" "$(_kcx_q "$KUBECONFIG")"
}

# ---- listing ------------------------------------------------------------------

_kcx_columns() {   # align tab-separated lines; macOS awk has no %*s, so build the format
  awk -F'\t' '
    { for (i = 1; i <= NF; i++) { v[NR, i] = $i; if (length($i) > w[i]) w[i] = length($i) }
      if (NF > nf) nf = NF }
    END { for (r = 1; r <= NR; r++) { line = ""
            for (i = 1; i < nf; i++) line = line sprintf("%-" w[i] "s  ", v[r, i])
            print line v[r, nf] } }'
}

_kcx_cmd_ls() {
  local quiet=0 f where cur kind a b rows="" ents="" stray="" inbox=0 other=""
  case "${1:-}" in -q) quiet=1 ;; '') ;; *) _kcx_usage_die "kcx ls takes only -q" ;; esac
  if [ -n "${KCX_RO:-}" ]; then printf '%s\n' "$KCX_RO"; return 0; fi
  if [ "$quiet" = 1 ]; then _kcx_all_contexts; return 0; fi
  cur="$(_kcx_current)"
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    where="$(_kcx_where "$f")"
    while IFS="$_kcx_tab" read -r kind a b; do
      case "$kind" in
        ctx) rows="${rows}$( [ "$a" = "$cur" ] && printf '*' )${_kcx_tab}${a}${_kcx_tab}${where}${_kcx_tab}${b}
"
             [ "$f" = "$_kcx_state" ] && inbox=$((inbox + 1)) ;;
        ent) ents="${ents}${a}${_kcx_tab}${b}${_kcx_tab}${f}
" ;;
        cur) [ "$f" != "$_kcx_state" ] && stray="${stray}  ${f}
" ;;
      esac
    done < <(_kcx_scan "$f")
  done < <(_kcx_files)
  if [ -z "$rows" ]; then
    _kcx_err "no contexts yet: kcx add NAME FILE|-|-- CMD..., or kcx temp create NAME"
  else
    printf '%s' "$rows" | _kcx_columns
  fi
  # What kubectl would quietly get wrong: the first file wins a name, so a second
  # "prod" cluster answers for the first; a managed file's own current-context fills
  # in when the state file has none; and files kcx does not list.
  printf '%s' "$ents" | awk -F'\t' '
    { k = $1 "\t" $2; if (k in first) { if (!(k in told)) { told[k] = 1
        printf "kcx: the %s %s is defined in %s and in %s; kubectl uses the first\n", $1, $2, first[k], $3 > "/dev/stderr" } }
      else first[k] = $3 }'
  # shellcheck disable=SC2088
  [ "$inbox" -gt 0 ] && _kcx_err "~/.kube/config holds $inbox context(s) another tool wrote there: kcx adopt CTX [NAME] gives one a file of its own"
  [ -n "$stray" ] && _kcx_err "these files set a current context of their own, which wins whenever the state file has none; clear it with kubectl --kubeconfig FILE config unset current-context:
$stray"
  for f in "$_kcx_perm" "$_kcx_tmpd"; do
    [ -d "$f" ] || continue
    other="$(find -H "$f" -mindepth 1 -maxdepth 1 ! -name '*.yaml' ! -name '.*' 2>/dev/null)"
    [ -n "$other" ] && _kcx_err "not in KUBECONFIG (kcx lists *.yaml files only): $(printf '%s' "$other" | tr '\n' ' ')"
  done
  return 0
}

# ---- importing ----------------------------------------------------------------

# Refuse when any ENTRY (map<TAB>name lines) is already defined in a file KUBECONFIG
# lists, other than SKIP. EXCEPT lists entries of the state file that are about to
# move out of it (kcx adopt).
_kcx_check_free() {
  local entries="$1" skip="$2" except="$3" f map name
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    [ "$f" = "$skip" ] && continue
    while IFS="$_kcx_tab" read -r map name; do
      [ -n "$name" ] || continue
      if [ -n "$except" ] && [ "$f" = "$_kcx_state" ] \
         && printf '%s\n' "$except" | grep -Fxq -- "${map}${_kcx_tab}${name}"; then
        continue
      fi
      if printf '%s\n' "$entries" | grep -Fxq -- "${map}${_kcx_tab}${name}"; then
        _kcx_die "a $map named $name already exists in $f; choose another name"
      fi
    done < <(_kcx_entries "$f")
  done < <(_kcx_files)
}

# Import one context from SRC into DEST. RENAME=1 names its cluster, user and context
# NAME (permanent clusters); 0 keeps the names the source gave them (kcx temp add).
# The result is self-contained (certificate files embedded), carries no current
# context, and is written through a dotfile in DEST's directory, then moved into
# place. REPLACE=1: an existing DEST goes to the Trash first.
_kcx_import() {
  local src="$1" dest="$2" name="$3" ctx="$4" server="$5" rename="$6" replace="$7" except="$8"
  local ctxs n json entries tmpj tmpy dir
  [ -r "$src" ] || _kcx_die "cannot read $src"
  ctxs="$(_kcx_contexts_in "$src")"
  if [ -z "$ctxs" ]; then n=0; else n="$(printf '%s\n' "$ctxs" | wc -l | tr -d ' ')"; fi
  if [ -n "$ctx" ]; then
    printf '%s\n' "$ctxs" | grep -Fxq -- "$ctx" \
      || _kcx_die "no context $ctx in $src; it has: $(printf '%s' "$ctxs" | tr '\n' ' ')"
  elif [ "$n" -eq 1 ]; then
    ctx="$ctxs"
  elif [ "$n" -eq 0 ]; then
    _kcx_die "$src holds no context"
  else
    _kcx_die "$src holds $n contexts; take one with --context: $(printf '%s' "$ctxs" | tr '\n' ' ')"
  fi
  json="$(kubectl --kubeconfig "$src" config view --raw --flatten --minify --context "$ctx" -o json 2>&1)" \
    || _kcx_die "kubectl cannot read context $ctx from $src: $json"
  json="$(printf '%s\n' "$json" | jq --arg n "$name" --arg s "$server" --arg r "$rename" '
      if ((.clusters // []) | length) != 1 then error("its context names no cluster that exists")
      elif ((.users // []) | length) > 1 then error("more than one user")
      else . end
      | if $r == "1" then
          .clusters[0].name = $n
          | .contexts[0].name = $n
          | .contexts[0].context.cluster = $n
          | if ((.users // []) | length) == 1
            then .users[0].name = $n | .contexts[0].context.user = $n else . end
        else . end
      | if $s != "" then .clusters[0].cluster.server = $s else . end
      | del(.["current-context"])' 2>&1)" || _kcx_die "cannot import $src: $json"
  entries="$(printf '%s\n' "$json" | jq -r '
      ((.clusters // [])[] | "cluster\t\(.name)"), ((.users // [])[] | "user\t\(.name)"),
      ((.contexts // [])[] | "context\t\(.name)")')"
  _kcx_check_free "$entries" "$dest" "$except"
  _kcx_ensure_layout
  dir="${dest%/*}"
  tmpj="$(mktemp "$dir/.kcx.XXXXXX")" || _kcx_die "mktemp failed in $dir"
  tmpy="$(mktemp "$dir/.kcx.XXXXXX")" || { rm -f -- "$tmpj"; _kcx_die "mktemp failed in $dir"; }
  _kcx_cleanup[${#_kcx_cleanup[@]}]="$tmpj"
  _kcx_cleanup[${#_kcx_cleanup[@]}]="$tmpy"
  printf '%s\n' "$json" > "$tmpj"
  kubectl --kubeconfig "$tmpj" config view --raw > "$tmpy" 2>/dev/null \
    && kubectl --kubeconfig "$tmpy" config get-contexts -o name 2>/dev/null | grep -q . \
    || _kcx_die "the converted kubeconfig did not read back; nothing was written"
  chmod 600 "$tmpy"
  if [ -e "$dest" ]; then
    [ "$replace" = 1 ] || _kcx_die "$dest exists"
    _kcx_trash "$dest" || _kcx_die "could not move the old $dest to the Trash; nothing was replaced"
  fi
  mv -f -- "$tmpy" "$dest" || _kcx_die "could not write $dest"
}

# kcx add / kcx temp add: [-f] [--context CTX] [--server URL] [--use] NAME (FILE | - | -- CMD...)
_kcx_cmd_add() {
  local where="$1"; shift
  local force=0 ctx="" server="" use=0 name="" src="" have_cmd=0 dest work input a rc
  local cmd; cmd=()
  while [ $# -gt 0 ]; do
    case "$1" in
      -f|--force) force=1; shift ;;
      --context) [ $# -ge 2 ] || _kcx_usage_die "--context needs a value"; ctx="$2"; shift 2 ;;
      --context=*) ctx="${1#--context=}"; shift ;;
      --server) [ $# -ge 2 ] || _kcx_usage_die "--server needs a value"; server="$2"; shift 2 ;;
      --server=*) server="${1#--server=}"; shift ;;
      --use) use=1; shift ;;
      --) shift; have_cmd=1; cmd=("$@"); break ;;
      -) [ -n "$name" ] && [ -z "$src" ] || _kcx_usage_die "kcx add NAME - reads standard input"; src="-"; shift ;;
      -*) _kcx_usage_die "unknown option $1" ;;
      *) if [ -z "$name" ]; then name="$1"
         elif [ -z "$src" ]; then src="$1"
         else _kcx_usage_die "unexpected argument $1"
         fi
         shift ;;
    esac
  done
  [ -n "$name" ] || _kcx_usage_die "kcx add needs a NAME"
  _kcx_valid_name "$name" || _kcx_die "$name: a name takes letters, digits, . _ and -, up to 63"
  if [ "$have_cmd" = 1 ]; then
    [ -z "$src" ] || _kcx_usage_die "give a FILE, - or -- CMD..., not two of them"
    [ "${#cmd[@]}" -gt 0 ] || _kcx_usage_die "nothing to run after --"
  else
    [ -n "$src" ] || _kcx_usage_die "kcx add $name needs FILE, - or -- CMD..."
  fi
  if [ "$where" = perm ]; then
    _kcx_lab_guard
    dest="$_kcx_perm/$name.yaml"
  else
    dest="$_kcx_tmpd/$name.yaml"
    a="$(_kcx_temp_file "$name" 2>/dev/null)"
    [ -z "$a" ] || [ "$a" = "$dest" ] || _kcx_die "a kind temp cluster named $name exists already ($a)"
  fi
  [ ! -e "$dest" ] || [ "$force" = 1 ] \
    || _kcx_die "$name exists already ($dest); -f replaces it and moves the old file to the Trash"
  _kcx_workdir; work="$_kcx_wd"
  if [ "$have_cmd" = 1 ]; then
    input="$work/kubeconfig"
    local run; run=()
    for a in "${cmd[@]}"; do
      if [ "$a" = "{}" ]; then run[${#run[@]}]="$input"; else run[${#run[@]}]="$a"; fi
    done
    ( umask 077; KUBECONFIG="$input" KCX_OUT="$input" "${run[@]}" )
    rc=$?
    [ "$rc" -eq 0 ] || _kcx_die "the command failed (exit $rc); nothing was imported"
    [ -s "$input" ] || _kcx_die "the command wrote no kubeconfig: tools that ignore KUBECONFIG need {} where their file option goes"
  elif [ "$src" = "-" ]; then
    input="$work/kubeconfig"
    ( umask 077; cat > "$input" )
    [ -s "$input" ] || _kcx_die "nothing on standard input"
  else
    input="$src"
  fi
  if [ "$where" = perm ]; then
    _kcx_import "$input" "$dest" "$name" "$ctx" "$server" 1 "$force" ""
    printf 'kcx: added %s (%s)\n' "$name" "$dest"
    a="$name"
    _kcx_hint_new "$a" "$dest"
  else
    _kcx_import "$input" "$dest" "$name" "$ctx" "$server" 0 "$force" ""
    a="$(_kcx_contexts_in "$dest")"
    printf 'kcx: kept temp cluster %s as context %s (%s)\n' "$name" "$a" "$dest"
    _kcx_hint_new "$a" "$dest"
  fi
  if [ "$use" = 1 ]; then _kcx_run_guard; _kcx_use "$a"; printf 'kcx: switched to %s\n' "$a"; fi
}

# A shell started before FILE existed does not list it, so kubectl --context fails
# there with "context was not found" until its KUBECONFIG is recomputed. Agents run
# each command in such a shell: say what works at once.
_kcx_hint_new() {   # CONTEXT FILE
  case ":${_kcx_inherited}:" in *":$2:"*) return 0 ;; esac
  printf 'kcx: kcx run %s -- CMD works now; kubectl --context %s once KUBECONFIG lists the file: in a new shell, at the next zsh prompt, or after eval "$(kcx env)"\n' "$1" "$1"
}

_kcx_lab_guard() {
  [ "$_kcx_lab_node" = 1 ] || return 0
  [ "${KCX_ALLOW_ON_LAB_NODE:-}" = 1 ] && return 0
  _kcx_die "this machine is a lab node (role docker-engine), and a permanent cluster's credentials do not belong on one: add it on a desktop instead. Temp clusters are fine here (kcx temp create)."
}

_kcx_cmd_rm() {
  local name="$1" f cur
  [ $# -eq 1 ] && [ -n "$name" ] || _kcx_usage_die "kcx rm NAME"
  f="$_kcx_perm/$name.yaml"
  if [ ! -f "$f" ]; then
    [ -n "$(_kcx_temp_file "$name" 2>/dev/null)" ] && _kcx_die "$name is a temp cluster: kcx temp rm $name"
    _kcx_die "no permanent cluster named $name (kcx ls lists them)"
  fi
  cur="$(_kcx_current)"
  _kcx_trash "$f" || _kcx_die "could not move $f to the Trash"
  printf 'kcx: moved %s to the Trash\n' "$f"
  if [ "$cur" = "$name" ]; then
    _kcx_clear_current
    printf 'kcx: there is no current context now; kcx NAME picks one\n'
  fi
}

_kcx_cmd_mv() {
  local old="$1" new="$2" src dest cur
  [ $# -eq 2 ] || _kcx_usage_die "kcx mv OLD NEW"
  src="$_kcx_perm/$old.yaml"
  [ -f "$src" ] || _kcx_die "no permanent cluster named $old"
  _kcx_valid_name "$new" || _kcx_die "$new: a name takes letters, digits, . _ and -, up to 63"
  dest="$_kcx_perm/$new.yaml"
  [ ! -e "$dest" ] || _kcx_die "$new exists already"
  cur="$(_kcx_current)"
  _kcx_import "$src" "$dest" "$new" "" "" 1 0 ""
  # The same credentials now live under the new name: this is a rename, not a removal.
  rm -f -- "$src"
  [ "$cur" = "$old" ] && _kcx_set_current "$new"
  [ -s "$_kcx_prev" ] && [ "$(cat -- "$_kcx_prev")" = "$old" ] && ( umask 077; printf '%s' "$new" > "$_kcx_prev" )
  printf 'kcx: renamed %s to %s\n' "$old" "$new"
  _kcx_hint_new "$new" "$dest"
}

_kcx_cmd_adopt() {
  local ctx="$1" name="${2:-$1}" dest json cl us cl_n us_n except cur
  [ $# -ge 1 ] && [ $# -le 2 ] && [ -n "$ctx" ] || _kcx_usage_die "kcx adopt CTX [NAME]"
  _kcx_lab_guard
  [ -f "$_kcx_state" ] && _kcx_contexts_in "$_kcx_state" | grep -Fxq -- "$ctx" \
    || _kcx_die "$ctx is not in ~/.kube/config; adopt moves what other tools wrote there"
  _kcx_valid_name "$name" || _kcx_die "$name cannot be a file name: kcx adopt '$ctx' NAME"
  dest="$_kcx_perm/$name.yaml"
  [ ! -e "$dest" ] || _kcx_die "$name exists already ($dest)"
  json="$(kubectl --kubeconfig "$_kcx_state" config view -o json 2>/dev/null)"
  cl="$(printf '%s\n' "$json" | jq -r --arg c "$ctx" '.contexts[] | select(.name == $c) | .context.cluster // ""')"
  us="$(printf '%s\n' "$json" | jq -r --arg c "$ctx" '.contexts[] | select(.name == $c) | .context.user // ""')"
  # The cluster and the user move too, unless another context there still uses them.
  cl_n="$(printf '%s\n' "$json" | jq --arg c "$ctx" --arg x "$cl" '[.contexts[] | select(.name != $c and .context.cluster == $x)] | length')"
  us_n="$(printf '%s\n' "$json" | jq --arg c "$ctx" --arg x "$us" '[.contexts[] | select(.name != $c and .context.user == $x)] | length')"
  except="context${_kcx_tab}${ctx}"
  [ "$cl_n" = 0 ] && [ -n "$cl" ] && except="${except}
cluster${_kcx_tab}${cl}"
  [ "$us_n" = 0 ] && [ -n "$us" ] && except="${except}
user${_kcx_tab}${us}"
  cur="$(_kcx_current)"
  _kcx_import "$_kcx_state" "$dest" "$name" "$ctx" "" 1 0 "$except"
  kubectl --kubeconfig "$_kcx_state" config delete-context "$ctx" >/dev/null 2>&1
  [ "$cl_n" = 0 ] && [ -n "$cl" ] && kubectl --kubeconfig "$_kcx_state" config delete-cluster "$cl" >/dev/null 2>&1
  [ "$us_n" = 0 ] && [ -n "$us" ] && kubectl --kubeconfig "$_kcx_state" config delete-user "$us" >/dev/null 2>&1
  [ "$cur" = "$ctx" ] && _kcx_set_current "$name"
  printf 'kcx: %s now lives in %s as %s\n' "$ctx" "$dest" "$name"
  _kcx_hint_new "$name" "$dest"
}

# ---- one command, one cluster ---------------------------------------------------

_kcx_cmd_run() {
  local ctx work
  [ $# -ge 3 ] && [ "$2" = "--" ] || _kcx_usage_die "kcx run NAME -- COMMAND..."
  ctx="$(_kcx_resolve_context "$1")" || _kcx_die "no context named $1 (kcx ls lists them)"
  shift 2
  _kcx_workdir; work="$_kcx_wd"
  # A state file of its own, first in the list: the command sees NAME as current, a
  # switch inside it changes only this copy, and no credential file is copied.
  jq -n --arg c "$ctx" '{apiVersion: "v1", kind: "Config", "current-context": $c}' > "$work/current.json"
  ( unset KCX_AUTO
    KUBECONFIG="$work/current.json:$KUBECONFIG" KCX_RUN="$ctx"
    export KUBECONFIG KCX_RUN
    exec "$@" )
}

# ---- the read-only shell ------------------------------------------------------

_kcx_cmd_ro() {
  local ctx="" work port i roctx rc
  local cmd; cmd=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --) shift; cmd=("$@"); break ;;
      -*) _kcx_usage_die "unknown option $1" ;;
      *) [ -z "$ctx" ] || _kcx_usage_die "kcx -r [NAME] [-- COMMAND...]"; ctx="$1"; shift ;;
    esac
  done
  if [ -z "$ctx" ]; then
    { [ -t 1 ] && command -v fzf >/dev/null 2>&1; } || _kcx_usage_die "name the context: kcx -r NAME [-- COMMAND...]"
    ctx="$(_kcx_all_contexts | fzf --prompt='read-only> ' --height=40% --reverse \
            --header='a READ-ONLY shell for which context? ESC cancels')"
    [ -n "$ctx" ] || return 0
  fi
  ctx="$(_kcx_resolve_context "$ctx")" || _kcx_die "no context named $ctx (kcx ls lists them)"
  _kcx_workdir; work="$_kcx_wd"
  # The proxy holds the credentials; the shell gets a kubeconfig with none, pointing
  # at the proxy. Started from a subshell so job control stays quiet.
  ( kubectl --context "$ctx" proxy --port=0 --reject-methods="$_kcx_ro_methods" \
      --reject-paths="$_kcx_ro_paths" >"$work/proxy.log" 2>&1 &
    printf '%s' "$!" > "$work/pid" )
  _kcx_proxy_pid="$(cat "$work/pid" 2>/dev/null)"
  port="" i=0
  while [ "$i" -lt 50 ]; do
    port="$(sed -n 's/.*Starting to serve on 127\.0\.0\.1:\([0-9][0-9]*\).*/\1/p' "$work/proxy.log" 2>/dev/null | head -1)"
    [ -n "$port" ] && break
    kill -0 "$_kcx_proxy_pid" 2>/dev/null || break
    sleep 0.2
    i=$((i + 1))
  done
  if [ -z "$port" ]; then
    _kcx_err "kubectl proxy did not start:"
    sed 's/^/  /' "$work/proxy.log" >&2
    exit 1
  fi
  roctx="$ctx (READ-ONLY)"
  jq -n --arg p "$port" --arg c "$roctx" '{apiVersion: "v1", kind: "Config",
      clusters: [{name: "readonly", cluster: {server: ("http://127.0.0.1:" + $p)}}],
      users: [{name: "readonly", user: {}}],
      contexts: [{name: $c, context: {cluster: "readonly", user: "readonly"}}],
      "current-context": $c}' > "$work/readonly.json"
  chmod 0400 "$work/readonly.json"
  # KCX_RO keeps it read-only through the shell's own startup files: ~/.zshenv and
  # `kcx env` leave this KUBECONFIG alone, and kcx refuses everything but queries.
  if [ "${#cmd[@]}" -gt 0 ]; then
    printf 'kcx: read-only run on %s\n' "$roctx" >&2
    ( unset KCX_AUTO KCX_RUN
      KUBECONFIG="$work/readonly.json" KCX_RO="$roctx" KCX_RO_CONFIG="$work/readonly.json"
      export KUBECONFIG KCX_RO KCX_RO_CONFIG
      exec "${cmd[@]}" )
    rc=$?
  else
    printf 'kcx: READ-ONLY shell for %s; exit to leave\n' "$ctx"
    printf 'kcx: reads work; writes, exec, attach, port-forward and auth can-i are refused by a local kubectl proxy\n'
    ( unset KCX_AUTO KCX_RUN
      KUBECONFIG="$work/readonly.json" KCX_RO="$roctx" KCX_RO_CONFIG="$work/readonly.json"
      export KUBECONFIG KCX_RO KCX_RO_CONFIG
      exec "${SHELL:-/bin/sh}" )
    rc=$?
    printf 'kcx: read-only shell closed\n'
  fi
  exit "$rc"
}

# ---- temp clusters --------------------------------------------------------------

_kcx_temp_file() {   # the kubeconfig of temp cluster NAME: NAME@ENGINE.yaml or NAME.yaml
  local f b found=""
  while IFS= read -r f; do
    b="${f##*/}"; b="${b%.yaml}"
    [ "${b%%@*}" = "$1" ] || continue
    [ -z "$found" ] || { _kcx_err "two kubeconfigs for temp cluster $1: $found $f"; return 2; }
    found="$f"
  done < <(_kcx_dir_files "$_kcx_tmpd")
  [ -n "$found" ] || return 1
  printf '%s\n' "$found"
}

_kcx_engine_address() {   # the IPv4 address other machines reach ENGINE at; empty when local
  local ep host
  ep="$(docker context inspect "$1" 2>/dev/null | jq -r '.[0].Endpoints.docker.Host // empty' 2>/dev/null)"
  [ -n "$ep" ] || { _kcx_err "no docker context named $1 (docker context ls)"; return 1; }
  case "$ep" in
    unix://*|npipe://*) return 0 ;;
    ssh://*)
      host="${ep#ssh://}"; host="${host#*@}"; host="${host%%/*}"; host="${host%%:*}"
      # an ssh alias: the address is whatever its HostName says
      host="$(ssh -G "$host" 2>/dev/null | awk '$1 == "hostname" { print $2; exit }')" ;;
    tcp://*)
      host="${ep#tcp://}"; host="${host%%/*}"; host="${host%%:*}" ;;
    *) _kcx_err "engine $1: an endpoint kcx does not know: $ep"; return 1 ;;
  esac
  [ -n "$host" ] || { _kcx_err "engine $1: no host in $ep"; return 1; }
  _kcx_resolve "$host"
}
_kcx_resolve() {
  local ip=""
  case "$1" in *[!0-9.]*) ;; *) printf '%s\n' "$1"; return 0 ;; esac
  if command -v dscacheutil >/dev/null 2>&1; then
    ip="$(dscacheutil -q host -a name "$1" 2>/dev/null | awk '/^ip_address:/ { print $2; exit }')"
  fi
  if [ -z "$ip" ] && command -v getent >/dev/null 2>&1; then
    ip="$(getent ahostsv4 "$1" 2>/dev/null | awk '{ print $1; exit }')"
  fi
  [ -n "$ip" ] || { _kcx_err "cannot resolve $1 to an IPv4 address"; return 1; }
  printf '%s\n' "$ip"
}
_kcx_free_port() {   # a host port no container on ENGINE publishes, in 41000-48999
  local used p i=0
  used="$(DOCKER_CONTEXT="$1" docker ps --format json 2>/dev/null | jq -r '.Ports // empty' 2>/dev/null \
          | tr ',' '\n' | sed -n 's/.*:\([0-9][0-9]*\)->.*/\1/p')"
  while [ "$i" -lt 50 ]; do
    p=$((41000 + RANDOM % 8000))
    printf '%s\n' "$used" | grep -Fxq -- "$p" || { printf '%s\n' "$p"; return 0; }
    i=$((i + 1))
  done
  return 1
}
_kcx_kind_clusters() {   # kind's clusters on ENGINE; fails when the engine does not answer
  DOCKER_CONTEXT="$1" kind get clusters 2>/dev/null
}

_kcx_cmd_temp() {
  local sub="${1:-}"
  [ $# -gt 0 ] && shift
  case "$sub" in
    create) _kcx_temp_create "$@" ;;
    ls|list) [ $# -eq 0 ] || _kcx_usage_die "kcx temp ls takes no arguments"; _kcx_temp_ls ;;
    rm|remove|delete) [ $# -eq 1 ] || _kcx_usage_die "kcx temp rm NAME"; _kcx_temp_rm "$1" ;;
    prune) [ $# -eq 0 ] || _kcx_usage_die "kcx temp prune takes no arguments"; _kcx_temp_prune ;;
    add) _kcx_cmd_add temp "$@" ;;
    '') _kcx_usage_die "kcx temp create|ls|rm|prune|add" ;;
    *) _kcx_usage_die "kcx temp: unknown command $sub" ;;
  esac
}

_kcx_temp_create() {
  local name="" engine="" config="" use=0 preset="" addr="" port="" cfg file work tries rc
  local have_a have_p srv
  local extra; extra=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --engine) [ $# -ge 2 ] || _kcx_usage_die "--engine needs a docker context"; engine="$2"; shift 2 ;;
      --engine=*) engine="${1#--engine=}"; shift ;;
      --config) [ $# -ge 2 ] || _kcx_usage_die "--config needs a preset or a file"; config="$2"; shift 2 ;;
      --config=*) config="${1#--config=}"; shift ;;
      --use) use=1; shift ;;
      --) shift; extra=("$@"); break ;;
      -*) _kcx_usage_die "unknown option $1 (kind's own options go after --)" ;;
      *) [ -z "$name" ] || _kcx_usage_die "kcx temp create NAME [options]"; name="$1"; shift ;;
    esac
  done
  [ -n "$name" ] || _kcx_usage_die "kcx temp create needs a NAME"
  _kcx_valid_kind_name "$name" || _kcx_die "$name: kind takes lowercase letters, digits, . and -, up to 40"
  command -v kind >/dev/null 2>&1 || _kcx_die "kind is not installed"
  command -v docker >/dev/null 2>&1 || _kcx_die "docker is not installed"
  [ -z "$(_kcx_temp_file "$name" 2>/dev/null)" ] || _kcx_die "a temp cluster named $name exists already (kcx temp ls)"
  [ -n "$engine" ] || engine="${DOCKER_CONTEXT:-$(docker context show 2>/dev/null)}"
  [ -n "$engine" ] || _kcx_die "no docker context to run on; name one with --engine"
  case "$engine" in *[!A-Za-z0-9_.+-]*|'') _kcx_die "$engine is not a docker context name" ;; esac
  if [ -n "$config" ]; then
    if [ -f "$config" ]; then preset="$config"
    elif [ -f "$_kcx_presets/$config.yaml" ]; then preset="$_kcx_presets/$config.yaml"
    else
      _kcx_die "no kind preset or file $config; presets: $(_kcx_presets_list | tr '\n' ' ')"
    fi
  fi
  _kcx_check_free "cluster${_kcx_tab}kind-$name
user${_kcx_tab}kind-$name
context${_kcx_tab}kind-$name" "" ""
  if DOCKER_CONTEXT="$engine" kind get clusters 2>/dev/null | grep -Fxq -- "$name"; then
    _kcx_die "a kind cluster named $name already runs on $engine (made from another machine?)"
  fi
  addr="$(_kcx_engine_address "$engine")" || exit 1
  _kcx_workdir; work="$_kcx_wd"
  _kcx_ensure_layout
  file="$_kcx_tmpd/$name@$engine.yaml"
  cfg="$preset"
  tries=1
  if [ -n "$addr" ]; then
    # A remote engine: kind would bind the API server to 127.0.0.1 on THAT machine,
    # which nothing here can reach, so it listens on the engine's address instead
    # (kind adds that address to the API server's certificate). kind finds a free
    # port by binding the address locally, which fails for a remote one, so kcx
    # chooses a port the engine does not publish, and tries again on a collision.
    cfg="$work/kind.yaml"
    have_a="" have_p=0
    if [ -n "$preset" ]; then
      command -v yq >/dev/null 2>&1 || _kcx_die "yq is needed to aim the preset $config at engine $engine"
      have_a="$(yq e '.networking.apiServerAddress // ""' "$preset")"
      have_p="$(yq e '.networking.apiServerPort // 0' "$preset")"
      case "$have_a" in 127.*|localhost|::1) _kcx_err "the preset binds the API server to $have_a; on $engine that is $addr instead"; have_a="" ;; esac
    fi
    [ -n "$have_a" ] && addr="$have_a"
    [ "$have_p" != 0 ] || tries=3
  fi
  while :; do
    if [ -n "$addr" ]; then
      port="$have_p"
      if [ "$port" = 0 ]; then port="$(_kcx_free_port "$engine")" || _kcx_die "no free port on $engine"; fi
      if [ -n "$preset" ]; then
        KCX_A="$addr" KCX_P="$port" yq e '.networking.apiServerAddress = strenv(KCX_A) | .networking.apiServerPort = env(KCX_P)' "$preset" > "$cfg" \
          || _kcx_die "yq could not rewrite $preset"
      else
        printf 'kind: Cluster\napiVersion: kind.x-k8s.io/v1alpha4\nnetworking:\n  apiServerAddress: "%s"\n  apiServerPort: %s\n' "$addr" "$port" > "$cfg"
      fi
    fi
    local args; args=(create cluster --name "$name" --kubeconfig "$file")
    [ -n "$cfg" ] && args=("${args[@]}" --config "$cfg")
    # Through tee, so a port collision can be recognised; all of it on stderr, where
    # kind writes its progress anyway.
    ( umask 077
      DOCKER_CONTEXT="$engine" kind "${args[@]}" ${extra[@]+"${extra[@]}"} 2>&1 | tee "$work/kind.err" >&2
      exit "${PIPESTATUS[0]}" )
    rc=$?
    [ "$rc" -eq 0 ] && break
    rm -f -- "$file"
    tries=$((tries - 1))
    if [ "$tries" -gt 0 ] && grep -qiE 'already allocated|address already in use' "$work/kind.err" 2>/dev/null; then
      _kcx_err "port $port is taken on $engine; trying another"
      continue
    fi
    _kcx_die "kind could not create $name on $engine"
  done
  kubectl --kubeconfig "$file" config unset current-context >/dev/null 2>&1   # managed files carry none
  chmod 600 "$file"
  srv="$(kubectl --kubeconfig "$file" config view -o jsonpath='{.clusters[0].cluster.server}' 2>/dev/null)"
  printf 'kcx: temp cluster %s is up on %s: context kind-%s, server %s\n' "$name" "$engine" "$name" "$srv"
  if [ "$use" = 1 ]; then
    _kcx_run_guard
    _kcx_use "kind-$name"
    printf 'kcx: switched to kind-%s\n' "$name"
  fi
  _kcx_hint_new "kind-$name" "$file"
  printf 'kcx: kcx temp rm %s deletes it\n' "$name"
}

_kcx_presets_list() {
  [ -d "$_kcx_presets" ] || return 0
  find -H "$_kcx_presets" -mindepth 1 -maxdepth 1 -type f -name '*.yaml' 2>/dev/null \
    | sed 's#.*/##; s#\.yaml$##' | LC_ALL=C sort
}

# STATE of each temp kubeconfig: up, gone (its engine answers without it), unknown
# (the engine does not answer), or other (not made by kcx temp create). Lines are
# name<TAB>engine<TAB>state<TAB>file; an engine is asked once.
_kcx_temp_states() {
  local f b name engine st asked="" list
  while IFS= read -r f; do
    b="${f##*/}"; b="${b%.yaml}"; name="${b%%@*}"
    case "$b" in
      *@*) engine="${b#*@}"
           case "$asked" in
             *"|$engine="*) ;;
             *) if list="$(_kcx_kind_clusters "$engine")"; then
                  asked="${asked}|$engine=$(printf '%s\n' "$list" | tr '\n' ',')"
                else
                  asked="${asked}|$engine=?"
                fi ;;
           esac
           list="${asked##*"|$engine="}"; list="${list%%|*}"
           if [ "$list" = "?" ]; then st=unknown
           elif printf '%s' ",$list" | grep -Fq -- ",$name,"; then st=up
           else st=gone
           fi ;;
      *) engine="-"; st=other ;;
    esac
    printf '%s\t%s\t%s\t%s\n' "$name" "$engine" "$st" "$f"
  done < <(_kcx_dir_files "$_kcx_tmpd")
}

_kcx_temp_ls() {
  local rows name engine st f ctx srv out=""
  rows="$(_kcx_temp_states)"
  [ -n "$rows" ] || { _kcx_err "no temp clusters (kcx temp create NAME)"; return 0; }
  while IFS="$_kcx_tab" read -r name engine st f; do
    ctx="$(_kcx_contexts_in "$f" | head -1)"
    srv="$(kubectl --kubeconfig "$f" config view -o jsonpath='{.clusters[0].cluster.server}' 2>/dev/null)"
    out="${out}${name}${_kcx_tab}${engine}${_kcx_tab}${st}${_kcx_tab}${ctx:--}${_kcx_tab}${srv:--}
"
  done <<EOF
$rows
EOF
  printf 'NAME\tENGINE\tSTATE\tCONTEXT\tSERVER\n%s' "$out" | _kcx_columns
}

_kcx_forget_temp() {   # FILE [ITS CONTEXTS]: clear the current context if it is one of
  # them, then delete FILE. Pass the contexts when kind has already emptied the file.
  local f="$1" ctxs="${2-}" cur
  [ $# -ge 2 ] || ctxs="$(_kcx_contexts_in "$f")"
  cur="$(_kcx_current)"
  if [ -n "$cur" ] && printf '%s\n' "$ctxs" | grep -Fxq -- "$cur"; then
    _kcx_clear_current
    printf 'kcx: %s was the current context; there is none now\n' "$cur"
  fi
  rm -f -- "$f"
}

_kcx_temp_rm() {
  local name="$1" f b engine ctxs
  f="$(_kcx_temp_file "$name")" || _kcx_die "no temp cluster named $name (kcx temp ls)"
  b="${f##*/}"; b="${b%.yaml}"
  ctxs="$(_kcx_contexts_in "$f")"   # before kind delete empties the file
  case "$b" in
    *@*)
      engine="${b#*@}"
      _kcx_kind_clusters "$engine" >/dev/null \
        || _kcx_die "$engine does not answer; the kubeconfig stays ($f). kcx temp prune clears it once the cluster is gone"
      DOCKER_CONTEXT="$engine" kind delete cluster --name "$name" --kubeconfig "$f" \
        || _kcx_die "kind could not delete $name on $engine; the kubeconfig stays ($f)"
      ;;
    *) _kcx_err "$name was made by another tool: delete the cluster with that tool; this removes only its kubeconfig" ;;
  esac
  _kcx_forget_temp "$f" "$ctxs"
  printf 'kcx: removed temp cluster %s\n' "$name"
}

_kcx_temp_prune() {
  local name engine st f n=0
  while IFS="$_kcx_tab" read -r name engine st f; do
    [ -n "$f" ] || continue
    case "$st" in
      gone) _kcx_forget_temp "$f"; printf 'kcx: removed the kubeconfig of %s, gone from %s\n' "$name" "$engine"; n=$((n + 1)) ;;
      unknown) _kcx_err "$engine does not answer; kept $f" ;;
    esac
  done <<EOF
$(_kcx_temp_states)
EOF
  [ "$n" -gt 0 ] || printf 'kcx: nothing to prune\n'
}

# ---- the picker -----------------------------------------------------------------

_kcx_cmd_pick() {
  local new='+ new temp cluster (kind)' cur pick f where line
  cur="$(_kcx_current)"
  pick="$( {
      printf '%s\n' "$new"
      while IFS= read -r f; do
        [ -f "$f" ] || continue
        where="$(_kcx_where "$f")"
        _kcx_contexts_in "$f" | while IFS= read -r line; do
          [ -n "$line" ] || continue
          if [ "$line" = "$cur" ]; then printf '%s\t(%s)  current\n' "$line" "$where"
          else printf '%s\t(%s)\n' "$line" "$where"; fi
        done
      done < <(_kcx_files)
    } | fzf --prompt='context> ' --height=40% --reverse --delimiter="$_kcx_tab" --tabstop=4 \
            --header='switch context; the top line makes a temp cluster; ESC cancels')"
  [ -n "$pick" ] || return 0
  if [ "$pick" = "$new" ]; then _kcx_temp_wizard; return $?; fi
  _kcx_run_guard
  _kcx_cmd_switch "${pick%%"$_kcx_tab"*}"
}

# "+ new temp cluster": the engine, then the config, then a name. ESC goes back a
# step, and at the first step cancels.
_kcx_temp_wizard() {
  local step=engine engine="" cfg="" name="" p
  command -v kind >/dev/null 2>&1 || _kcx_die "kind is not installed"
  while :; do
    case "$step" in
      engine)
        engine="$(docker context ls --format json 2>/dev/null \
          | jq -r '"\(.Name)\t\(.DockerEndpoint)\(if .Current then "  (current)" else "" end)"' \
          | fzf --prompt='Engine> ' --height=40% --reverse --delimiter="$_kcx_tab" \
                --header='which Docker engine runs the cluster; ESC cancels' | cut -f1)"
        [ -n "$engine" ] || return 0
        step=config ;;
      config)
        cfg="$( { printf -- '-\tkind'\''s own: one node\n'
                  _kcx_presets_list | while IFS= read -r p; do printf '%s\t%s\n' "$p" "$_kcx_presets/$p.yaml"; done
                } | fzf --prompt='Config> ' --height=40% --reverse --delimiter="$_kcx_tab" \
                        --header="on $engine; ESC goes back" | cut -f1)"
        if [ -z "$cfg" ]; then step=engine; continue; fi
        step=name ;;
      name)
        printf 'Name for the temp cluster (lowercase, digits, - and .; empty goes back): ' >/dev/tty
        IFS= read -r name </dev/tty || return 0
        if [ -z "$name" ]; then step=config; continue; fi
        break ;;
    esac
  done
  if [ "$cfg" = "-" ]; then _kcx_temp_create "$name" --engine "$engine"
  else _kcx_temp_create "$name" --engine "$engine" --config "$cfg"
  fi
}

# ---- completion -----------------------------------------------------------------

# Words for tab completion, given the words already typed after `kcx`.
_kcx_cmd_complete() {
  local last="" w
  for w in "$@"; do last="$w"; done
  case "$last" in
    --engine) docker context ls --format json 2>/dev/null | jq -r '.Name' 2>/dev/null; return 0 ;;
    --config) _kcx_presets_list; return 0 ;;
    --context|--server|-) return 0 ;;
  esac
  case "${1:-}" in
    temp)
      case "${2:-}" in
        rm|remove|delete) _kcx_dir_files "$_kcx_tmpd" | sed 's#.*/##; s#\.yaml$##; s#@.*##' ;;
        create) printf '%s\n' --engine --config --use ;;
        '') printf '%s\n' create ls rm prune add ;;
      esac ;;
    rm|remove|mv|rename) [ $# -eq 1 ] && _kcx_dir_files "$_kcx_perm" | sed 's#.*/##; s#\.yaml$##' ;;
    adopt) [ -f "$_kcx_state" ] && [ $# -eq 1 ] && _kcx_contexts_in "$_kcx_state" ;;
    run|-r) [ $# -eq 1 ] && _kcx_all_contexts ;;
    add) printf '%s\n' -f --context --server --use ;;
    '') _kcx_all_contexts; printf '%s\n' ls env run add rm mv adopt temp -r -c - -h -v ;;
  esac
  return 0
}

# ---- main -----------------------------------------------------------------------

_kcx_run_guard() {
  [ -z "${KCX_RUN:-}" ] || _kcx_die "inside kcx run the context is $KCX_RUN for the whole command; switch outside it"
}

_kcx_main() {
  # The KUBECONFIG every kubectl call here uses: recomputed from the directories,
  # except in a read-only shell or a kcx run, whose KUBECONFIG is the point of them.
  _kcx_inherited="${KUBECONFIG-}"
  if [ -z "${KCX_RO:-}" ] && [ -z "${KCX_RUN:-}" ]; then
    KUBECONFIG="$(_kcx_kubeconfig)"
    export KUBECONFIG
  fi
  if [ -n "${KCX_RO:-}" ]; then
    case "${1:-}" in
      ''|ls|list|env|-c|current|__complete|-h|--help|help|-v|--version) ;;
      *) _kcx_die "this is a READ-ONLY shell for $KCX_RO: only kcx ls, env and -c work here; exit it first" ;;
    esac
  fi
  command -v kubectl >/dev/null 2>&1 || _kcx_die "kubectl is not installed"
  command -v jq >/dev/null 2>&1 || _kcx_die "jq is not installed"
  case "${1:-}" in
    '')
      if [ -z "${KCX_RO:-}" ] && [ -t 1 ] && command -v fzf >/dev/null 2>&1; then _kcx_cmd_pick
      else _kcx_cmd_ls
      fi ;;
    -h|--help|help) _kcx_usage ;;
    -v|--version) printf 'kcx %s\n' "$_KCX_VERSION" ;;
    -c|current) _kcx_cmd_current ;;
    -) [ $# -eq 1 ] || _kcx_usage_die "kcx - takes no arguments"; _kcx_run_guard; _kcx_cmd_previous ;;
    ls|list) shift; _kcx_cmd_ls "$@" ;;
    env) _kcx_cmd_env ;;
    run) shift; _kcx_cmd_run "$@" ;;
    -r) shift; _kcx_cmd_ro "$@" ;;
    add) shift; _kcx_cmd_add perm "$@" ;;
    rm|remove) shift; _kcx_cmd_rm "$@" ;;
    mv|rename) shift; _kcx_cmd_mv "$@" ;;
    adopt) shift; _kcx_run_guard; _kcx_cmd_adopt "$@" ;;
    temp) shift; _kcx_cmd_temp "$@" ;;
    __complete) shift; _kcx_cmd_complete "$@" ;;
    -*) _kcx_usage_die "unknown option $1" ;;
    *) [ $# -eq 1 ] || _kcx_usage_die "kcx NAME switches; other commands: kcx -h"
       _kcx_run_guard; _kcx_cmd_switch "$1" ;;
  esac
}

_kcx_main "$@"

#!/usr/bin/env bash
# claude-desktop-update - update the Claude desktop app by hand.
#
# The app's own updater is blocked by a configuration profile (see
# run_check-claude-desktop-policy.sh): left on, it downloads an update and
# relaunches the app once the Mac has been idle for ten minutes. The relaunch
# stops every Code session, and Remote Control comes back for a session only
# when a message is sent to it, so a Mac reached from the phone goes dark
# exactly while its user is away. Updates now happen when you choose, at the
# Mac: `up` says when a newer version is out, and this installs it.
#
#   claude-desktop-update           show the versions, and update after a yes
#   claude-desktop-update --check   one line if a newer version is out, else nothing
#
# Since 2026-10-12 this is `cask-update claude`, kept under its own name: the same
# steps serve every pinned cask (quit the app, unpin, brew upgrade --cask --greedy,
# pin again, reopen). It refuses to run in a shell inside the Claude desktop app,
# whose session the quit would end; run it in Terminal or Ghostty.
exec cask-update "$@" claude

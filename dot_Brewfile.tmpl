{{- /* A machine's own packages (README, "Work overlay"): ~/.config/dotfiles/packages.toml
       may skip or replace entries below, and ~/.Brewfile.local is added at the end. The
       packages-filter template applies them to this file's own text, which it gets by
       rendering this file again with packages_raw set. With neither file the output is
       the list exactly as written. That second pass reads the file from the source
       directory, so rendering a copy over stdin (an older one from `git archive`, say)
       needs --source pointing at the copy's tree. */ -}}
{{- if not (hasKey . "packages_raw") -}}
{{-   includeTemplate "packages-filter" (dict "file" "dot_Brewfile.tmpl" "format" "brew" "data" .) | trimSuffix "\n" -}}
{{- else -}}
{{- if eq .machine "mac-personal" -}}
{{- $lab := false -}}{{- if hasKey . "roles" }}{{ $lab = has "docker-engine" .roles }}{{ end -}}
{{- /* A session host runs the concierge, a command-line Claude Code kept by launchd
       (claude-concierge), so its CLI takes the stable channel: a bad release there
       would break every session at once. A lab node runs no sessions. */ -}}
{{- $host := false -}}{{- if hasKey . "roles" }}{{ $host = and (has "session-host" .roles) (not $lab) }}{{ end -}}
{{- /* An INTEL Mac. Homebrew stopped building Intel bottles in September 2026, so a
       formula with no bottle is compiled here, and a few of them drag in Rust and
       LLVM first: hours, repeated on every toolchain release. Those come from their
       own prebuilt binaries through mise instead; see decision 0006 in the vault.
       Keyed on the architecture, never on a machine name, like the casks below. */ -}}
{{- $intel := eq .chezmoi.arch "amd64" -}}
# Brewfile (mac-personal) — apply with `brew bundle --global`
# Languages (node, python, terraform, opentofu) are managed by mise.
#
# A machine with the docker-engine role is a LAB NODE: an engine other machines
# build on, reached over ssh, with nobody sitting at it. It gets the same
# command-line experience as the desktops — prompt, completions, kubernetes
# tools, the lot — by DENY-LIST rather than allow-list, so anything added here
# later reaches it automatically. Three groups are withheld, for reasons that are
# properties of the machine rather than opinions about the tools:
#   * media and graphics (ffmpeg, imagemagick, ghostscript, librsvg) — nothing
#     renders on a headless box, and on Intel these are the expensive source
#     builds, 10 to 15 dependencies each.
#   * cloud CLIs (aws, azure, aliyun, oci) — a lab node is deliberately given no
#     credentials, so they would have nothing to authenticate with.
#   * every GUI cask except the engine itself.
# The Go-based tools still build from source on Intel, but at one dependency
# each that is minutes, not hours, and only once.

# --- Taps ---
{{ if and (eq .chezmoi.arch "arm64") (not $lab) }}tap "docker/tap"{{ end }}     # Docker Sandboxes (sbx): only where the sbx cask is, the one place run_trust-taps.sh trusts it
tap "junior/tap"
{{ if not $lab }}tap "hashicorp/tap"{{ end }}   # Vault left homebrew-core with its licence change; HashiCorp keeps this tap


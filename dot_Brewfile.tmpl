{{ if not $lab }}brew "junior/tap/s3tx"{{ end }}   # s3tx: files through a private S3 bucket, tx is its far end; its tap is trusted in run_trust-taps.sh
{{ if not $lab }}brew "hashicorp/tap/vault"{{ end }}   # the Vault CLI; its tap is trusted in run_trust-taps.sh
{{ if not $lab }}cask "vercel"{{ end }}   # a cask since homebrew-core moved it there: Vercel's native build, no node


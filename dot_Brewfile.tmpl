# --- Casks: terminal + editors ---
cask "cursor"
cask "ghostty"
cask "visual-studio-code"

# --- Casks: browsers ---
cask "firefox"
cask "google-chrome"
cask "google-chrome@canary"   # renamed upstream from google-chrome-canary (old name 404s)
cask "tor-browser"

# --- Casks: network ---
# wifiman installs via pkg (one sudo prompt the first time).
cask "wifiman"
# Wireshark is deliberately NOT declared. The `wireshark-app` cask (the GUI; the
# `wireshark` formula is the CLI-only build) installs two pkgs besides the app:
# "Add Wireshark to the system path" and "Install ChmodBPF", the latter
# a ROOT LaunchDaemon that chmods /dev/bpf* at every boot so non-root processes can
# capture. That is a persistent, admin-level change to how the machine handles packet
# capture, and it is not something a new Mac should acquire silently. Wireshark is an
# on-demand tool here: install it by hand when a capture is actually needed
#   brew install --cask wireshark-app
# or better, capture inside a container on a lab node and leave the Mac untouched.
# A hand install is not pinned: when its cask moves, a bare `brew upgrade` in `up`
# upgrades it too and stops at a password prompt (its two packages reinstall as
# root), so remove it after the capture:
#   brew uninstall --cask wireshark-app
# The uninstall leaves the `access_bpf` group. Leave it too: some capture tools ship
# their own copy of ChmodBPF, which gives /dev/bpf* to that same group at boot.

# --- Casks: containers + Kubernetes UIs ---
cask "docker-desktop"
cask "freelens"
cask "openlens"
cask "stratoshark"

# --- Casks: communication + productivity ---
# 1Password: the direct-download build (not the App Store one), adopted in place.
cask "1password"
# The CLI (`op`). Needed for the secrets plan: chezmoi `onepasswordRead` in templates so
# ~/.aws and the s3tx exports stop being hand-carried, and it is what makes a new Mac
# reproducible rather than hand-built. Two things stay manual in the app, they are GUI
# toggles: Settings > Developer > "Integrate with 1Password CLI", and the SSH agent.
# Not pinned: this cask has no auto_updates, `brew upgrade` in `up` moves it.
cask "1password-cli"
cask "discord"
cask "microsoft-teams"
cask "notion"
# Obsidian: the reader for the vaults under ~/vaults, git-backed Markdown shared by
# several tools. Self-updating, so it is pinned in run_pin-self-updating-casks.sh. A GUI
# app, so a lab node never gets it; the vaults themselves are plain files and need no app.
cask "obsidian"
cask "webex"
cask "zoom"

# --- Casks: dev tools / API ---
cask "apidog"

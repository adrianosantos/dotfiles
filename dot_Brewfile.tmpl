cask "forklift"
cask "monokle"
cask "dash"
cask "drawio"
cask "github"
cask "gitkraken"
cask "gpg-suite"
# Homebrew's own GUI (BrewUI), new with Homebrew 7. It needs macOS 26 or later, which
# every desktop here runs; the Intel iMac is a lab node and gets no GUI casks. A desktop
# on an older macOS would need a guard, because `brew bundle` fails on an unmet
# requirement. Not self-updating, so `up`'s `brew upgrade` moves it.
cask "homebrew-app"
cask "httpie-desktop"
cask "jetbrains-toolbox"
cask "kaleidoscope"
cask "mitmproxy"
cask "ngrok"
cask "postman"
cask "termius"
cask "tower"

# --- Casks: AI / misc ---
cask "chatgpt"
# Claude Desktop. Self-updating, so it is pinned in run_pin-self-updating-casks.sh:
# brew must never try to replace a running, root-owned app bundle (the Chrome lesson).
# Its own updater is blocked too, by a configuration profile that
# run_check-claude-desktop-policy.sh checks for: the relaunch that installs an
# update drops every Remote Control connection. `cask-update claude` updates it.
cask "claude"
# Claude Code CLI. Two casks exist and they conflict, so pick one: `claude-code` follows
# the stable channel (about a week behind, skipping releases with known major regressions),
# `claude-code@latest` takes every release. @latest matches wsl-work, whose native install
# tracks the same channel. NOTE the difference in who updates it: a Homebrew install does
# not self-update, so `up`'s `brew upgrade` is what moves this one, while wsl-work's
# native install updates itself in the background. A session host (role session-host)
# takes the stable one, for its concierge; `brew bundle` never removes the other, so a
# Mac that takes the role swaps them once by hand:
#   brew uninstall --cask claude-code@latest && brew install --cask claude-code
{{ if $host }}cask "claude-code"{{ else }}cask "claude-code@latest"{{ end }}
cask "codex"
cask "grammarly-desktop"
cask "microsoft-auto-update"
{{- if eq .chezmoi.arch "arm64" }}
# Apple-silicon-only casks (their upstream ships no Intel build), gated on the
# architecture rather than the machine name so an Intel Mac can share this
# profile without `brew bundle` failing on them every `up`.
# sbx: microVM sandboxes for coding agents. Standalone — its own VM backend,
# independent of any Docker/Podman engine. Linux needs KVM; macOS does not.
cask "docker/tap/sbx"
cask "lm-studio"

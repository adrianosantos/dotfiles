{{ if eq .machine "mac-personal" -}}
#!/usr/bin/env bash
# Pin casks that keep THEMSELVES current.
#
# Chrome Canary rebuilds daily, so Homebrew is permanently "behind" and retries an
# upgrade on every `up` — an upgrade that then fails, because replacing a RUNNING,
# root-owned app bundle needs both the app closed and App Management (TCC) rights
# the terminal usually lacks. Result: "Upgrading <cask> has failed!" forever.
#
# Pinning tells brew to skip them; their own updaters keep them current (brew's own
# `pin` help says as much for auto_updates casks). An updater runs only while its app
# does, so one that has not run for a while falls behind: `up` names those, by the
# app's own version (cask-update --check), and `cask-update NAME` updates one.
# They're still declared in the Brewfile, so a fresh machine still installs them:
# Brewfile has no pin syntax, which is why this lives here. Edit PINNED to
# add/remove; unpin by hand with `brew unpin --cask <name>` after removing it from
# the list.
#
# A plain run_ script, NOT run_onchange_, and that distinction is load-bearing: a
# cask listed here may not be installed yet when this runs, because `up` applies
# chezmoi BEFORE `brew bundle install` reaches a newly declared cask. An onchange
# script that skipped for that reason would record itself as done and never retry,
# leaving the cask permanently unpinned — which is how `claude` slipped through on
# the day it was added. Running every apply costs one `brew list --pinned`.
# QUIET BY DESIGN: it prints only when it actually pins something.
set -eu

# docker-desktop joined on 2026-09-21: it updates itself (auto_updates), and
# brew's upgrade of it removes root-owned privileged helpers, so it needs sudo.
# That makes `up` unable to finish over ssh on the lab node, which is exactly how
# that machine is driven. Its own updater keeps it current.
#
# wireshark-app is the one entry the Brewfile does NOT declare: it is installed by
# hand when a capture needs it (the Brewfile says why), and listing it here pins
# such an install at the next apply. Unpinned, it would stop `up` at a password
# prompt: by default a bare `brew upgrade` also upgrades an auto_updates cask
# whose app is older than the cask, and Wireshark's updater runs only while the
# app does. Upgrading this cask reinstalls its two installer packages, as root.
{{- /* Each name goes through this machine's packages.toml (README, "Work overlay"): a
       cask it skips is left out, one it replaces is pinned under the replacement's
       token. With no such file the list is exactly the one written here. */}}
PINNED=({{ includeTemplate "package" (dict "names" "1password claude docker-desktop forklift google-chrome google-chrome@canary obsidian wireshark-app" "data" . "tokens" true) }})

command -v brew >/dev/null 2>&1 || exit 0

already="$(brew list --pinned 2>/dev/null || true)"

for c in "${PINNED[@]}"; do
  brew list --cask "$c" >/dev/null 2>&1 || continue     # not installed yet — a later apply retries
  if printf '%s\n' "$already" | grep -qx "$c"; then
    continue                                            # already pinned — stay silent
  fi
  echo ">>> pinning self-updating cask: $c (its own updater keeps it current)"
  brew pin --cask "$c" >/dev/null 2>&1 || echo ">>> WARN: could not pin $c"
done
{{ end -}}

{{ if eq .machine "mac-personal" -}}
#!/usr/bin/env bash
# Unload the concierge's launchd job wherever it still runs.
#
# The concierge was dropped on 2026-11-01 (decision 0022 in the vault): the Claude
# desktop app now lets the phone start sessions on the Mac, and a session started
# that way brings the others back. .chezmoiremove takes the job's plist,
# ~/Library/LaunchAgents/local.claude-remote-control.plist, the script it ran and
# its folder, so launchd no longer starts it at login. A job loaded before that
# keeps running until the next logout: this unloads it, and the concierge's own
# TERM trap stops its tmux server.
#
# A plain run_after_ script, so it runs at every apply, after the plist is gone.
# QUIET BY DESIGN: it prints only when it unloads something.
set -eu

label=local.claude-remote-control
target="gui/$(id -u)/$label"

launchctl print "$target" >/dev/null 2>&1 || exit 0
if launchctl bootout "$target" 2>/dev/null; then
  echo ">>> the concierge is gone: unloaded its launchd job ($label)"
else
  echo ">>> WARN: could not unload $label; run: launchctl bootout $target"
fi
{{ end -}}

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ~/Library/LaunchAgents/local.claude-remote-control.plist - managed by chezmoi, on a
  Mac with the role session-host. The concierge: launchd keeps claude-concierge
  running, which keeps Claude Code's Remote Control server running in a tmux session
  of its own (see ~/.local/bin/claude-concierge). `up` restarts it after the Claude
  Code cask moves, through this label. Load it once with `claude-concierge start`,
  after the first sign-in in the concierge's folder; launchd loads it at every login
  after that.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.claude-remote-control</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>{{ .chezmoi.homeDir }}/.local/bin/claude-concierge</string>
		<string>run</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<!-- Only in the logged-in GUI session: its keychain holds Claude Code's sign-in. -->
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<!-- No throttling of the sessions it hosts. -->
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>WorkingDirectory</key>
	<string>{{ .chezmoi.homeDir }}</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>SHELL</key>
		<string>/bin/sh</string>
		<key>LANG</key>
		<string>en_US.UTF-8</string>
	</dict>
	<key>StandardOutPath</key>
	<string>{{ .chezmoi.homeDir }}/Library/Logs/claude-concierge.launchd.log</string>
	<key>StandardErrorPath</key>
	<string>{{ .chezmoi.homeDir }}/Library/Logs/claude-concierge.launchd.log</string>
</dict>
</plist>

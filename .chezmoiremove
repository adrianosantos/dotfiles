# Targets chezmoi removes on apply (chezmoi reads this file as a template). The
# bash kcx 1.0 these dotfiles installed on the Macs until October 2026, replaced
# by the Go kcx that mise installs.
.local/bin/kcx
{{ if eq .machine "mac-personal" -}}
# The concierge, dropped on 2026-11-01 (decision 0022 in the vault): the Claude
# desktop app now lets the phone start sessions on the Mac, and a session started
# that way brings the others back. Its launchd job, the script the job ran and the
# folder its sessions started in go from every Mac that still has them;
# run_after_unload-concierge.sh unloads a job that still runs.
Library/LaunchAgents/local.claude-remote-control.plist
.local/bin/claude-concierge
.config/claude-concierge
{{ end -}}

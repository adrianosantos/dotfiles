{{ if ne .machine "mac-personal" -}}
# .zshenv sets KUBECONFIG for kcx on the personal Macs, and on a lab node also the
# PATH that ssh commands need. Kubeconfigs on wsl-work belong to its private overlay,
# and linux-minimal runs bash. kcx itself is a personal-Mac tool for the same reason.
.zshenv
.local/bin/kcx
{{- end }}
{{ $lab := "" }}{{ if hasKey . "lab_hosts" }}{{ $lab = .lab_hosts }}{{ end }}
{{ if not $lab -}}
# The lab ssh fragment is generated from `lab_hosts` in the chezmoi config; with
# nothing declared there is nothing to write. Ignore the DIRECTORY as well as the
# file: ignoring only the file still left chezmoi creating an empty ~/.ssh/config.d,
# which is clutter on hosts that will never have a lab host (the jumphosts have
# tiny homes). A private overlay creates the directory itself when it needs it.
.ssh/config.d
.ssh/config.d/lab
{{- end }}
{{ if ne .machine "mac-personal" -}}
# Only the Macs keep ~/.ssh/config unmanaged, so only they need the include line
# added: for lab hosts, or for a private overlay's hosts on a work Mac.
ensure-ssh-include.sh
{{- end }}
{{ if or (ne .machine "mac-personal") (has "docker-engine" $roles) -}}
# The Claude desktop app runs only on the personal Macs that are not lab nodes:
# the profile that blocks its own updater has nothing to do anywhere else.
.config/claude-desktop
{{- end }}
{{ if ne .machine "mac-personal" -}}
# Homebrew casks exist only on the personal Macs, so cask-update has nothing to do
# anywhere else.
.local/bin/cask-update
{{- end }}
